#!/bin/sh
# Aktivér:  git config core.hooksPath scripts/hooks

# Dataseparation: stop commits med sager, brugerdata eller hemmeligheder (se ARKITEKTUR.md).
python3 "$(git rev-parse --show-toplevel)/scripts/tjek_data.py" || {
  echo "Commit afvist af dataseparationen. Fjern sagsdata/hemmeligheder, eller generalisér teksten." >&2
  exit 1
}

# Protokoller: det committede indhold skal være i synk med faelles/ (ikke kun arbejdskopien).
python3 "$(git rev-parse --show-toplevel)/scripts/sync_protokol.py" --staged || {
  echo "Commit afvist: protokollerne er ude af synk i det, der committes. Kør scripts/sync_protokol.py og git add." >&2
  exit 1
}

# Fælles miljømodul: plugin-kopierne skal svare til faelles/miljoe.py i det, der committes.
python3 "$(git rev-parse --show-toplevel)/scripts/sync_miljoe.py" --staged || {
  echo "Commit afvist: miljoe.py er ude af synk med faelles/miljoe.py. Kør scripts/sync_miljoe.py og git add." >&2
  exit 1
}

# Parallel udvikling: versioner hæves kun ved udgivelse på main (scripts/udgiv.py), aldrig i en feature-gren.
gren=$(git symbolic-ref --short -q HEAD)
if [ "$gren" != "main" ] && [ -z "$BYG_UDGIV" ] && \
   git diff --cached -U0 --diff-filter=M -- 'plugins/*/.claude-plugin/plugin.json' .claude-plugin/marketplace.json \
     | grep -qE '^[+-][[:space:]]*"version"'; then
  echo "Commit afvist: versionen er ændret i grenen '$gren'. Læg i stedet en note i versionsnoter/$gren.md" >&2
  echo "(se versionsnoter/README.md) – versionerne hæves ved udgivelse på main med scripts/udgiv.py." >&2
  exit 1
fi

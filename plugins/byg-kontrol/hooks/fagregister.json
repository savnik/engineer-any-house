{
  "fag": {
    "vvs": {
      "agent": "vvs-mester",
      "kontrol": "vvs-kontrol"
    },
    "el": {
      "agent": "el-installatoer",
      "kontrol": "el-kontrol"
    },
    "murer": {
      "agent": "murermester",
      "kontrol": "murer-kontrol"
    },
    "ventilation": {
      "agent": "ventilationsekspert",
      "kontrol": "ventilation-kontrol"
    },
    "maler": {
      "agent": "malermester",
      "kontrol": "maler-kontrol"
    },
    "toemrer": {
      "agent": "toemrermester",
      "kontrol": "toemrer-kontrol"
    },
    "bim": {
      "agent": "bim-modelloer",
      "kontrol": "bim-kontrol",
      "hjaelpere": [
        "bim-sammenligner"
      ],
      "skriv": [
        "bim/forslag/*",
        "bim/kilder/*"
      ],
      "skriv_ny": [
        "bim/model.yaml"
      ],
      "git_ekstra": [
        "bim/historik/*",
        "bim/sammenligning/*"
      ],
      "vaerktoejskontrol": true
    },
    "statik": {
      "agent": "statiker",
      "kontrol": "statik-kontrol",
      "regnevaerktoej": [
        "statik.py",
        "fem.py"
      ],
      "skriv": [
        "fem/*"
      ],
      "kontrol_skrivefri": {
        "fem.py": {
          "regn": "--ingen-filer",
          "test": "",
          "skabelon": ""
        }
      }
    },
    "arkitekt": {
      "agent": "arkitekt",
      "kontrol": "arkitekt-kontrol"
    },
    "anlaeg": {
      "agent": "anlaegsgartner",
      "kontrol": "anlaeg-kontrol"
    }
  },
  "skriv_alle": [
    "fagnotater/{fag}.md",
    "fagnotater/{fag}-*.md",
    "bilag/{fag}/*",
    "forslag/{fag}-*__*.md"
  ],
  "projekt_kontrol": "projekt-kontrol",
  "kontrol_plugin": "byg-kontrol",
  "samlet_plugin": "byg",
  "maks_forsoeg": 2,
  "maks_runder": 2,
  "maks_sammenligninger": 3,
  "stikproeve": {
    "andel": 0.34,
    "aldrig_fag": [
      "el",
      "statik"
    ],
    "begrundelse": "F-012 (2026-10-20): på enkeltstående fagspørgsmål fangede let kontrol 0 af 7 forkerte svar og afviste 6 rigtige. Stikprøve kun for spørgsmål uden sag; el og statik altid kontrolleret."
  }
}

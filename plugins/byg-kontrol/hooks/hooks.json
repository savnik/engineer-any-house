{
  "description": "byg-kontrol: håndhæver uafhængig kvalitetskontrol af byg-fagleverancer (højst 3 forsøg pr. runde, derefter root cause-analyse, forbedring af fagagenten og ny runde; højst 3 runder).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/kontrol_gate.py\" pretool", "timeout": 30}
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/kontrol_gate.py\" subagentstop", "timeout": 30}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/kontrol_gate.py\" stop", "timeout": 30}
        ]
      }
    ]
  }
}
